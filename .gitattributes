# Scripts must be LF, otherwise they break on Linux/Docker (dash does not read a CRLF shebang).
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files — CRLF.
*.bat text eol=crlf

# Binaries are not normalised.
*.jar binary
*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
