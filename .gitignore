.claude/
.gstack/
.gitnexus/
.agents/
.idea/

# Git Bash crash dumps on Windows — junk, not tracked
*.stackdump

# Stray npm/npx junk in the root (there is no root package.json — the frontend lives in frontend/)
/node_modules/

# Local .env files with secrets are NOT committed; only the *.env.example samples are tracked
.env
.env.*
!.env.example
AGENTS.md
# Velobike API capture (contains session token/PII — never commit)
*.har

# The owner's drafts in the repo root (preview scripts, input/generated images).
# Root only — frontend assets in frontend/public/ are tracked as usual.
/*.py
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.html

# Wave dumps for comparing skins — an intermediate result, not a source
.wavedump/

# Cache of Overpass dumps for the bike-graph builder — raw material, not a result
backend/tools/.osm-cache/

# The MapLibre worker — a copy from node_modules (scripts/copy-maplibre-worker.mjs), not a source
frontend/public/maplibre/
