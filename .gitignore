.claude/
.gstack/
.gitnexus/
.agents/
.idea/

# Crash-дампы Git Bash на Windows — мусор, не трекаем
*.stackdump

# Случайный npm/npx-мусор в корне (корневого package.json нет — фронт живёт в frontend/)
/node_modules/

# Локальные .env с секретами — НЕ коммитим; трекаются только образцы *.env.example
.env
.env.*
!.env.example
AGENTS.md
# Velobike API capture (contains session token/PII — never commit)
*.har

# Черновики владельца в корне репо (превью-скрипты, входные/сгенерированные картинки).
# Только корень — ассеты фронта в frontend/public/ трекаются как обычно.
/*.py
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.html

# Выгрузки волн для сравнения скинов — промежуточный результат, не исходник
.wavedump/

# Кэш выгрузок Overpass для сборщика велографа — сырьё, не результат
backend/tools/.osm-cache/

# Воркер MapLibre — копия из node_modules (scripts/copy-maplibre-worker.mjs), не исходник
frontend/public/maplibre/
