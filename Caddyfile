# danchuo.world — edge: TLS, reverse proxy, and the only place abuse can be stopped (the ceilings
# below and the measurements behind them: PRD §8). /api/* goes STRAIGHT to Quarkus, so a drop zip
# never meets Next's body limit. Edit here, not on the VPS; needs the image from caddy/Dockerfile.
{
	# Both are plugin directives, absent from Caddy's built-in ordering, so they are placed explicitly.
	# rate_limit comes first, so a refused request costs nothing downstream; cache next, so a served
	# hit still counts against the limiter above it.
	order rate_limit before basic_auth
	order cache after rate_limit

	# Caddy's OWN logs (startup, TLS, errors). ⚠️ NOT the access log: in global options `log` sets
	# the default logger, while access logging is a per-site directive. Confusing the two is silent
	# — the config is valid, startup is chatty, and not one request is ever recorded.
	log default {
		output stdout
		format json

		# The limiter writes an info line per refused request, and one 600 rps flood produced 26k of
		# them. Every refusal already appears in the access log below as a 429 with client and path
		# attached, so this is pure duplication.
		exclude http.handlers.rate_limit
	}

	cache {
		# Short on purpose. The page is per-request dynamic (`cookies()` in app/page.tsx makes the
		# route permanently dynamic and Next answers `no-store`), so this is not a content cache but
		# a burst absorber: ten seconds turns any flood into ~0.1 rps of real rendering.
		ttl 10s

		# `bypass` means ignore the RFC cacheability of the response. Required precisely because Next
		# sends `Cache-Control: private, no-store` on the dynamic route; without it the cache would
		# sit in the path and never store a thing.
		mode bypass

		allowed_http_verbs GET HEAD

		key {
			# The wave cookie is the ONLY thing that varies `/` between visitors (DESIGN §2.6), so it
			# belongs in the key — otherwise one visitor previewing wave-02 serves their palette to
			# everybody for the next ten seconds.
			template "{http.request.method} {http.request.host}{http.request.uri.path}?{http.request.uri.query} wave={http.request.cookie.danchuo_wave}"
		}
	}
}

danchuo.world {
	encode zstd gzip

	# Carried by every response, /api and /dav included. HSTS without `preload` and without
	# `includeSubDomains` deliberately: both are one-way doors and nothing here asks for them.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	# THE access log — one line per request with client, path, status and duration. It must live
	# inside the site block: the global `log` above does not produce it, and without this line
	# there is no record of traffic at all, only of what broke. PRD §8
	log {
		output stdout
		format json
	}

	handle /api/* {
		# The API answers JSON, images and two one-off OAuth pages; no document of its own loads
		# anything. `none` is the echelon under escaping: a reflected parameter cannot run. PRD §8
		header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'"

		# Body ceilings by tier, because Quarkus `max-body-size` is global and the drop zip sets
		# it to 512M for everyone. The matchers MUST NOT overlap: when two `request_body`
		# directives match one request, the last one's ceiling is what survives. PRD §8
		@drop_upload path /api/ingest/drops*
		request_body @drop_upload {
			max_size 600MB
		}

		# Public telemetry: a beacon is a few hundred bytes and a click batch is capped at 50.
		@public_post path /api/analytics/*
		request_body @public_post {
			max_size 32KB
		}

		# A note is three answers of 2000 chars; in Cyrillic UTF-8 that is ~12KB, so 64KB is
		# fourfold and still far under the ingest tier; a tier list (§5.20) is a few KB of ids. Its own
		# matcher, not the telemetry one: overlapping `request_body` matchers keep only the last ceiling.
		@feedback_post path /api/feedback /api/tierlists
		request_body @feedback_post {
			max_size 64KB
		}

		# Everything else is the owner's ingest behind the bearer — generous, since an artifact
		# picture and a day of sleep chunks pass here, but no longer unbounded.
		@api_rest not path /api/ingest/drops* /api/analytics/* /api/feedback /api/tierlists
		request_body @api_rest {
			max_size 8MB
		}

		# Frames counted apart from the rest, mirroring the split inside RateLimitFilter. The `api`
		# zone MUST exclude them explicitly, or a frame is charged to both zones and silently capped
		# at the lower limit. Numbers and why: PRD §8
		rate_limit {
			zone film {
				match {
					path /api/film-media/*
				}
				key {remote_host}
				events 600
				window 1m
			}
			# Notes: the outer echelon of the ceiling RateLimitFilter also enforces (50/hour). It
			# sits ABOVE the app's, deliberately — the app owns the honest number, the edge only
			# keeps a flood off it, and a backstop under it would mask that. PRD §5.19, §11
			zone feedback {
				match {
					method POST
					path /api/feedback /api/tierlists
				}
				key {remote_host}
				events 60
				window 1h
			}
			# A note is charged to this zone as well, and that double-charge is deliberate: the
			# lower ceiling wins, which is the feedback one. Unlike frames, notes are too few for
			# the shared budget to notice.
			zone api {
				match {
					not path /api/film-media/*
				}
				key {remote_host}
				events 300
				window 1m
			}
		}

		reverse_proxy backend:8080 {
			# THE invariant behind RateLimitFilter.INTERNAL_HEADER: the backend reads this header as
			# proof a request came from SSR over the compose network and skips rate limiting. Stripping
			# it here is what makes that safe — public traffic can never carry it, whatever it sends.
			header_up -X-Danchuo-Internal
		}
	}

	# Anx Reader sync (PRD §5.16, §8). Two traps: the /dav prefix must NOT be stripped, because
	# PROPFIND replies carry absolute hrefs; and bare /dav must match alongside /dav/*, or Anx's
	# probe of the base URL falls through to Next and the device reports a failed sync test.
	@dav path /dav /dav/*
	handle @dav {
		reverse_proxy webdav:6065
	}

	handle {
		# Two zones because one page view is one document but ~30 asset requests, and a single budget
		# would either throttle a real first load or be too loose to matter. PRD §8
		rate_limit {
			zone assets {
				match {
					path /_next/* /assets/*
				}
				key {remote_host}
				events 900
				window 1m
			}
			zone pages {
				match {
					not path /_next/* /assets/*
				}
				key {remote_host}
				events 60
				window 1m
			}
		}

		# The optimizer's photos vary by Accept (AVIF or JPEG), which the cache key does not carry;
		# they have a cache of their own inside Next. PRD §8
		@page_cacheable not path /_next/image*
		cache @page_cacheable

		reverse_proxy frontend:3000 {
			# The pool that turns an outage back into mere slowness: unbounded, Caddy opens a
			# connection per request until Node's accept queue overflows and every dial times out.
			# Bounded, the excess waits here. Measured capacity and the incident: PRD §8
			transport http {
				max_conns_per_host 48
			}
		}
	}
}

www.danchuo.world {
	redir https://danchuo.world{uri} permanent
}
