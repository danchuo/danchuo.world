# danchuo.world · backend — образец локального .env (PRD §M3).
# Quarkus читает .env из корня модуля (backend/) автоматически. Скопируй в `.env`
# и заполни. РЕАЛЬНЫЙ .env в .gitignore — секреты не коммитим.

# ── Креды записи (PRD §3): bearer на /api/ingest/*. В dev можно оставить дефолт. ──
DANCHUO_INGEST_TOKEN=dev-ingest-token-change-me

# ── Spotify (PRD §M3). Без этих переменных слайс грузится «не сконфигурирован». ──
# CLIENT_ID / CLIENT_SECRET — из дашборда приложения: https://developer.spotify.com/dashboard
DANCHUO_SPOTIFY_CLIENT_ID=
DANCHUO_SPOTIFY_CLIENT_SECRET=
# REDIRECT_URI — ты задаёшь его сам и прописываешь ТОЧНО ТАК ЖЕ в дашборде приложения
# (Settings → Redirect URIs). Spotify требует https, исключение — loopback-IP по http
# (именно 127.0.0.1, НЕ localhost). Локально:
DANCHUO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
# TOKEN_KEY — твой ключ шифрования refresh-токена (НЕ от Spotify). Сгенерировать:
#   openssl rand -base64 32   (ровно 32 байта → AES-256)
DANCHUO_SPOTIFY_TOKEN_KEY=
