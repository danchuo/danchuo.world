# danchuo.world · backend — sample local .env (PRD §M3).
# Quarkus reads .env from the module root (backend/) automatically. Copy it to `.env`
# and fill it in. The REAL .env is in .gitignore — secrets are not committed.

# ── Write credentials (PRD §3): the bearer on /api/ingest/*. In dev the default is fine. ──
DANCHUO_INGEST_TOKEN=dev-ingest-token-change-me

# ── Spotify (PRD §M3). Without these variables the slice loads as "not configured". ──
# CLIENT_ID / CLIENT_SECRET — from the app dashboard: https://developer.spotify.com/dashboard
DANCHUO_SPOTIFY_CLIENT_ID=
DANCHUO_SPOTIFY_CLIENT_SECRET=
# REDIRECT_URI — you choose it yourself and register it EXACTLY THE SAME in the app dashboard
# (Settings → Redirect URIs). Spotify requires https, except for a loopback IP over http
# (exactly 127.0.0.1, NOT localhost). Locally:
DANCHUO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
# TOKEN_KEY — your key for encrypting the refresh token (NOT from Spotify). Generate it:
#   openssl rand -base64 32   (exactly 32 bytes → AES-256)
DANCHUO_SPOTIFY_TOKEN_KEY=
