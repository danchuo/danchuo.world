<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The checklist slice (PRD §5.6, §7). Discipline items are data-driven (a new one is a row,
      no release). target is the count goal (reading/podcasts = 2/day). Marks are
      checklist_entry, unique by (date,item_id) for an idempotent upsert.
    -->
    <changeSet id="0020-checklist-item-table" author="danchuo">
        <createTable tableName="checklist_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="label" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(128)"/>
            <column name="target" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0020-checklist-entry-table" author="danchuo">
        <createTable tableName="checklist_entry">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="count" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="checklist_entry"
                             columnNames="date, item_id"
                             constraintName="uq_checklist_entry_date_item"/>
        <addForeignKeyConstraint
                constraintName="fk_checklist_entry_item"
                baseTableName="checklist_entry" baseColumnNames="item_id"
                referencedTableName="checklist_item" referencedColumnNames="id"/>
    </changeSet>

    <!-- First-iteration seed of the items (PRD §5.6). Resolved by key (zero hardcoded ids). -->
    <changeSet id="0020-checklist-item-seed" author="danchuo">
        <insert tableName="checklist_item">
            <column name="key" value="stretch"/>
            <column name="label" value="Растяжка"/>
            <column name="target" valueNumeric="1"/>
            <column name="sort_order" valueNumeric="10"/>
        </insert>
        <insert tableName="checklist_item">
            <column name="key" value="reading"/>
            <column name="label" value="Чтение"/>
            <column name="target" valueNumeric="2"/>
            <column name="sort_order" valueNumeric="20"/>
        </insert>
        <insert tableName="checklist_item">
            <column name="key" value="podcasts"/>
            <column name="label" value="Английские подкасты"/>
            <column name="target" valueNumeric="2"/>
            <column name="sort_order" valueNumeric="30"/>
        </insert>
        <insert tableName="checklist_item">
            <column name="key" value="journal"/>
            <column name="label" value="Дневник перед сном"/>
            <column name="target" valueNumeric="1"/>
            <column name="sort_order" valueNumeric="40"/>
        </insert>
        <insert tableName="checklist_item">
            <column name="key" value="office"/>
            <column name="label" value="Офис по расписанию"/>
            <column name="target" valueNumeric="1"/>
            <column name="sort_order" valueNumeric="50"/>
        </insert>
        <insert tableName="checklist_item">
            <column name="key" value="monster"/>
            <column name="label" value="Монстр"/>
            <column name="target" valueNumeric="1"/>
            <column name="sort_order" valueNumeric="60"/>
        </insert>
    </changeSet>
</databaseChangeLog>
