<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Слайс social (PRD §5.8, §7, §12 M4): соцссылки + артефакты marquee. Data-driven —
      новая ссылка/артефакт = строка, без релиза. Иконки соцссылок — SVG-спрайты, статика
      фронта, красятся токеном волны через CSS-маску. Артефакт может быть без картинки
      (image_url nullable — marquee рисует пиксель-плейсхолдер вместо PNG/GIF).

      Консолидировано перед 1.0.0 (прод стартует с чистой цепочки): сюда свёрнуты бывшие
      0110 (nullable image_url + артефакты без картинок) и 0190 (SVG-иконки, GitHub-аккаунт,
      X/Instagram).
    -->
    <changeSet id="0070-social-link-table" author="danchuo">
        <createTable tableName="social_link">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="platform" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(512)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0070-artifact-table" author="danchuo">
        <createTable tableName="artifact">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(512)"/>
            <column name="first_mentioned_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="model_3d_url" type="VARCHAR(512)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

