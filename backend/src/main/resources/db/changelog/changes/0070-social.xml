<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The social slice (PRD §5.8, §7, §12 M4): social links + marquee artifacts. Data-driven:
      a new link/artifact is a row, no release. Social link icons are SVG sprites, frontend
      statics, painted with the wave token via a CSS mask. An artifact may have no picture
      (image_url nullable: the marquee draws a pixel placeholder instead of a PNG/GIF).

      Consolidated before 1.0.0 (prod starts from a clean chain): the former
      0110 (nullable image_url + artifacts without pictures) and 0190 (SVG icons, GitHub account,
      X/Instagram) are folded in here.
    -->
    <changeSet id="0070-social-link-table" author="danchuo">
        <createTable tableName="social_link">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="platform" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(512)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0070-artifact-table" author="danchuo">
        <createTable tableName="artifact">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(512)"/>
            <column name="first_mentioned_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="model_3d_url" type="VARCHAR(512)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

