<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The analytics slice (PRD §5.11, §7, §12 M4): our own cookieless solution in Postgres.
      The raw IP is not stored, only the daily hash visitor_day_hash. Indexes for the summary
      (by date), for counting uniques (by hash) and for topping up dwell (by visit_id).
    -->
    <changeSet id="0090-analytics-event-table" author="danchuo">
        <createTable tableName="analytics_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="visitor_day_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="device_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="referrer" type="VARCHAR(512)"/>
            <column name="dwell_ms" type="INT"/>
            <column name="is_bot" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="visit_id" type="VARCHAR(64)"/>
        </createTable>

        <createIndex tableName="analytics_event" indexName="idx_analytics_occurred_at">
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="analytics_event" indexName="idx_analytics_visitor_day_hash">
            <column name="visitor_day_hash"/>
        </createIndex>
        <createIndex tableName="analytics_event" indexName="idx_analytics_visit_id">
            <column name="visit_id"/>
        </createIndex>
    </changeSet>

    <!--
      Heatmap (PRD §5.11, B2): per-tile clicks, cookieless. The raw IP is not stored, only
      the daily hash (as in analytics_event). Coordinates are inside the tile (a 0..1 fraction), not screen
      pixels. Indexes for the aggregate (path+occurred_at) and for the per-visitor cap on read
      (visitor_day_hash). Consolidated before 1.0.0: the former separate 0160 is the same slice.
    -->
    <changeSet id="0090-interaction-event-table" author="danchuo">
        <createTable tableName="interaction_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="tile_id" type="VARCHAR(64)"/>
            <column name="offset_x_pct" type="DOUBLE PRECISION"/>
            <column name="offset_y_pct" type="DOUBLE PRECISION"/>
            <column name="viewport_w" type="INT"/>
            <column name="visitor_day_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="is_bot" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="visit_id" type="VARCHAR(64)"/>
        </createTable>

        <createIndex tableName="interaction_event" indexName="idx_interaction_path_occurred_at">
            <column name="path"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="interaction_event" indexName="idx_interaction_visitor_day_hash">
            <column name="visitor_day_hash"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
