<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Слайс film (PRD §5.12, §7, §12 M4; DESIGN §7.5): фото-дропы. Кадры лежат в хранилище
      (локальный диск за PhotoStorage, позже S3/R2), URL-ы вариантов (web/thumb) генерятся из
      ключа "{dropId}/{sortOrder}" — путь в БД не хранится (консолидировано перед 1.0.0:
      каркасная колонка image_url из M4 и её снос в бывшем 0150 схлопнуты). Без сида: таблицы
      наполняются загрузкой через /admin. film_photo.width/height — для justified-композиции.
    -->
    <changeSet id="0100-film-drop-table" author="danchuo">
        <createTable tableName="film_drop">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="dropped_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="month_label" type="VARCHAR(64)"/>
            <column name="photo_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="cover_photo_id" type="BIGINT"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0100-film-photo-table" author="danchuo">
        <createTable tableName="film_photo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="drop_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="width" type="INT"/>
            <column name="height" type="INT"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="film_photo" baseColumnNames="drop_id"
                constraintName="fk_film_photo_drop"
                referencedTableName="film_drop" referencedColumnNames="id"
                onDelete="CASCADE"/>
        <createIndex tableName="film_photo" indexName="idx_film_photo_drop">
            <column name="drop_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
