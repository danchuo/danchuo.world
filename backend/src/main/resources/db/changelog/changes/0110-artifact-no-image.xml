<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Артефакты без картинки (PRD §5.8): image_url становится опциональным — артефакт
      может быть только подписью (marquee рисует пиксель-плейсхолдер вместо PNG/GIF).
      Плюс сид-примеры без картинок.
    -->
    <changeSet id="0110-artifact-image-nullable" author="danchuo">
        <dropNotNullConstraint tableName="artifact" columnName="image_url" columnDataType="VARCHAR(512)"/>
    </changeSet>

    <changeSet id="0110-artifact-no-image-seed" author="danchuo">
        <insert tableName="artifact">
            <column name="name" value="Очки"/>
            <column name="first_mentioned_on" valueDate="2026-03-10"/>
            <column name="sort_order" valueNumeric="30"/>
        </insert>
        <insert tableName="artifact">
            <column name="name" value="Футболка 1"/>
            <column name="first_mentioned_on" valueDate="2026-03-25"/>
            <column name="sort_order" valueNumeric="40"/>
        </insert>
        <insert tableName="artifact">
            <column name="name" value="Футболка 2"/>
            <column name="first_mentioned_on" valueDate="2026-04-05"/>
            <column name="sort_order" valueNumeric="50"/>
        </insert>
    </changeSet>
</databaseChangeLog>
