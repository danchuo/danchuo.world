<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The data freshness indicator (PRD §8, the M5 era). A singleton row: "when the phone
      last reached ingest" (the last successful day upsert; both channels,
      health 12/18/24 and the interactive discipline, write through DayRecordService).
      The semantics are the moment of *ingest*, not of the day's last change; an alert about the shortcut dying is
      backlog (B5), here there is only a quiet indicator in the UI. We seed the single row (id=1)
      with an empty last_ingest_at (NULL = "no ingests yet", the UI shows empty).
    -->
    <changeSet id="0110-ingest-status" author="danchuo">
        <createTable tableName="ingest_status">
            <column name="id" type="smallint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_ingest_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <insert tableName="ingest_status">
            <column name="id" valueNumeric="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>
