<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      B9 (PRD §5.12, §9 item 13): LLM validation of photo-drop frame rotation. Film scans
      all arrive landscape (there is no EXIF orientation): portrait/upside-down frames
      are straightened by a vision LLM (the llm slice) or by hand in the admin.
        - orientation_checked_at: the frame was checked (LLM or by hand); a repeated run does not touch it.
        - orientation_applied: the check's result: none / cw90 / ccw90 / r180 / ambiguous / manual.
        - rotated_at: the web+thumb bytes were actually rewritten by the rotation; a version for cache-busting
          (?v= in the URL), since /api/film-media is cached as immutable.
    -->
    <changeSet id="0130-film-photo-orientation" author="danchuo">
        <addColumn tableName="film_photo">
            <column name="orientation_checked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="orientation_applied" type="VARCHAR(16)"/>
            <column name="rotated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
