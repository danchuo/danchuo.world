<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The bike slice (PRD §9 B4): a cache of station coordinates by address, so ride pins are drawn by
      station (a reliable address → geocode) rather than by the bike's raw GPS (a jump to Sheremetyevo).

      - bike_station: address → coordinates, idempotent by address ⇒ UNIQUE. found marks
        already tried addresses without a match (not retried). Filled by the background StationGeocoder.
    -->
    <changeSet id="0150-bike-station-table" author="danchuo">
        <createTable tableName="bike_station">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_bike_station_address"/>
            </column>
            <column name="lat" type="DOUBLE PRECISION"/>
            <column name="lon" type="DOUBLE PRECISION"/>
            <column name="found" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="geocoded_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
