<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      B1 (PRD §5.12, §9 п.7): включаем реальную загрузку фото-дропов через /admin.

      Кадры теперь лежат в хранилище (локальный диск за PhotoStorage, позже S3/R2), а URL-ы
      вариантов (web/thumb) генерятся из ключа "{dropId}/{sortOrder}" — хранить путь в БД не
      нужно. Поэтому убираем film_photo.image_url (каркасную колонку M4): она была плоским URL
      одного варианта, несовместимым с двух-вариантной раздачей. Таблицы пусты (до B1 данных
      не было) — снос колонки безопасен.
    -->
    <changeSet id="0150-film-photo-drop-image-url" author="danchuo">
        <dropColumn tableName="film_photo" columnName="image_url"/>
    </changeSet>
</databaseChangeLog>
