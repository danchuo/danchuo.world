<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The bike slice: "just the city" placeholder addresses ("Moscow": a bike left outside a named
      station) had been geocoded to the city centroid and overrode the exact GPS with a pin on Red
      Square. The geocoder no longer touches such addresses (StationGeocoder.isCityPlaceholder);
      already cached rows are reset to "not found", so the pin honestly falls back to GPS.
      The placeholder sign is a single word without digits or commas (all real addresses are multi-word).
    -->
    <changeSet id="0180-bike-station-placeholder-reset" author="danchuo">
        <sql>
            UPDATE bike_station
            SET found = false, lat = NULL, lon = NULL
            WHERE btrim(address) ~ '^[^0-9[:space:],]+$'
        </sql>
    </changeSet>
</databaseChangeLog>
