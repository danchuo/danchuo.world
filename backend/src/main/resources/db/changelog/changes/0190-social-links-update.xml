<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Соцссылки (PRD §5.8): правка имени GitHub-аккаунта, спрайт-иконки (SVG, статика фронта,
      красятся токеном волны через CSS-маску) и две новые платформы (X, Instagram). Сид 0070
      уже применён — не правим его, а накатываем UPDATE/INSERT поверх (как 0140 поверх 0080).
    -->
    <changeSet id="0190-social-link-icons-and-github" author="danchuo">
        <update tableName="social_link">
            <column name="url" value="https://github.com/danchuo"/>
            <column name="icon" value="/assets/social/github.svg"/>
            <where>platform = 'github'</where>
        </update>
        <update tableName="social_link">
            <column name="icon" value="/assets/social/telegram.svg"/>
            <where>platform = 'telegram'</where>
        </update>
    </changeSet>

    <changeSet id="0190-social-link-x-instagram" author="danchuo">
        <insert tableName="social_link">
            <column name="platform" value="x"/>
            <column name="name" value="X"/>
            <column name="url" value="https://x.com/danchuo"/>
            <column name="icon" value="/assets/social/x.svg"/>
            <column name="sort_order" valueNumeric="30"/>
        </insert>
        <insert tableName="social_link">
            <column name="platform" value="instagram"/>
            <column name="name" value="Instagram"/>
            <column name="url" value="https://instagram.com/danchuo_"/>
            <column name="icon" value="/assets/social/instagram.svg"/>
            <column name="sort_order" valueNumeric="40"/>
        </insert>
    </changeSet>
</databaseChangeLog>
