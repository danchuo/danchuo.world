<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Project "planet" sprites (DESIGN §12.2): wave-agnostic frontend statics in
      /assets/projects/. The "px" suffix in a file name means real pixel art, the frontend
      renders it nearest-neighbour; smooth sprites live without the suffix.
    -->
    <changeSet id="0200-project-planet-sprite-px" author="danchuo">
        <update tableName="project">
            <column name="icon_url" value="/assets/projects/danchuo-world-px.png"/>
            <where>title = 'danchuo.world'</where>
        </update>
    </changeSet>

    <!--
      The danchuo.world link leads to the site itself, not to the GitHub profile (the owner's note).
    -->
    <changeSet id="0200-project-danchuo-url" author="danchuo">
        <update tableName="project">
            <column name="url" value="https://danchuo.world"/>
            <where>title = 'danchuo.world'</where>
        </update>
    </changeSet>

    <!--
      The danchuo.world range: a single quarter Q3 2026, finished (the owner's decision: no
      "to date"). The frontend collapses matching ends into "Q3 2026".
    -->
    <changeSet id="0200-project-danchuo-q3" author="danchuo">
        <update tableName="project">
            <column name="start_quarter" valueNumeric="3"/>
            <column name="end_year" valueNumeric="2026"/>
            <column name="end_quarter" valueNumeric="3"/>
            <where>title = 'danchuo.world'</where>
        </update>
    </changeSet>

    <!--
      The second project: proxemics (finished, lived one quarter; the frontend collapses equal range ends
      into "Q2 2026"). It goes below danchuo.world: finished projects in the public
      list come under the ongoing "to date" ones.
    -->
    <changeSet id="0200-project-proxemics-seed" author="danchuo">
        <insert tableName="project">
            <column name="title" value="proxemics"/>
            <column name="icon_url" value="/assets/projects/proxemics.png"/>
            <column name="start_year" valueNumeric="2026"/>
            <column name="start_quarter" valueNumeric="2"/>
            <column name="end_year" valueNumeric="2026"/>
            <column name="end_quarter" valueNumeric="2"/>
            <column name="url" value="https://github.com/danchuo/proxemics"/>
            <column name="sort_order" valueNumeric="20"/>
        </insert>
    </changeSet>
</databaseChangeLog>
