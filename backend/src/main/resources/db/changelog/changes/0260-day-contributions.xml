<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      GitHub contributions per day (PRD 5.4, registry I-01): "a different kind of activity" next to
      steps and sleep. We count contributions in full (commits + PRs + reviews + issues), not commits:
      with the "one branch = one commit" convention the commit count systematically understates the day
      a large feature landed.

      Nullable on purpose, and the difference matters here more often than for other stats:
        null = the day was not collected (the channel has not run yet, the day is older than the fragment's window);
        0    = collected, there were no contributions: an ordinary, frequent and honest day.
      They must not be collapsed into one: the chip on the board is silent in both cases, but the calendar
      lens (I-19) must tell "empty" from "not measured".
    -->
    <changeSet id="0260-day-contributions" author="danchuo">
        <addColumn tableName="day_record">
            <column name="contributions" type="INT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
