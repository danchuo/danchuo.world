<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The GitHub contributions channel colour (DESIGN §2.1, §7.4): the "+N" chip in the stats tile.

      The token is named by ROLE (accent-code), not by colour: the green here carries meaning (it is git's
      colour) but is foreign to both palettes. A direct green literal in the component would repeat
      the mistake for which the monster flavour colours were removed from the board: seven foreign colours arguing
      with the wave. So the wave chooses the shade, and the component knows nothing about colour.

        wave-01  a warm mossy one: next to the peach GitHub's acid green would ring like an alarm.
        wave-02  a cold arcade one: Obscura has one signal orange for the whole board,
                 contributions need their own voice from the same 8-bit palette.

      An UPDATE over the applied 0080-theme-seed (the seed's checksum must not be touched); `||`
      adds one key, the rest of the waves' token sets do not change. The same values sit as
      a CSS fallback in wave-01.css / wave-02.css: the board does not go white if the DB is unavailable.
    -->
    <changeSet id="0270-wave-01-accent-code" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET tokens = tokens || $J${"accent-code": "#5f9e52"}$J$::jsonb WHERE key = 'wave-01';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET tokens = tokens - 'accent-code' WHERE key = 'wave-01';
        ]]></rollback>
    </changeSet>

    <changeSet id="0270-wave-02-accent-code" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET tokens = tokens || $J${"accent-code": "#2fb27a"}$J$::jsonb WHERE key = 'wave-02';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET tokens = tokens - 'accent-code' WHERE key = 'wave-02';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
