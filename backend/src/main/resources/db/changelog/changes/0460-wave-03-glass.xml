<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME"'s glass density (DESIGN §10.2): four material tokens.

      Why in the DB and not only in the skin: the owner chose glass on ALL tiles, against
      Apple's advice to keep it in one navigation layer. The insurance against this choice is
      not a refusal but a knob: if a measurement on the assembled board shows a slowdown, the blur can be
      toned down or removed by editing one row, without rewriting the skin or rebuilding the frontend.

      The same values sit as a CSS fallback right in the `var()` inside wave-03.css: the board does not
      lose its glass if the backend is unavailable.

      An UPDATE over the 0450 seed (the seed's checksum must not be touched); the two vertical bars
      overwrite the existing keys and add new ones.
    -->
    <changeSet id="0460-wave-03-glass-density" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET tokens = tokens || $J${
  "glass-blur": "20px",
  "glass-tint": "rgba(120, 160, 190, 0.13)",
  "glass-edge": "rgba(160, 205, 230, 0.18)",
  "glass-sheen": "rgba(190, 230, 250, 0.22)"
}$J$::jsonb WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET tokens = tokens - 'glass-blur' - 'glass-tint' - 'glass-edge' - 'glass-sheen'
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
