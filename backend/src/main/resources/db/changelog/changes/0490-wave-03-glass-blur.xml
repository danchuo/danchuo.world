<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": glass blur 20px → 12px (DESIGN §10.2).

      The knob from the 0460 seed worked exactly as intended: one row edited, without
      a line of CSS. The reason is not performance but the canvas's readability: the ribbon of lived
      days is set at 12.5px and lives at 11.5% opacity, and a full 20px pass rubbed it
      behind the tile into a flat field: the glass stopped being glass. At 12px the lower pass
      still mutes the background under the data figures, while the smeared text behind the tile is visible.

      The fallback in the `var()` inside wave-03.css is updated with the same number. (An XML comment cannot
      contain a double hyphen, so the token name here is written without it.)
    -->
    <changeSet id="0490-wave-03-glass-blur" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET tokens = tokens || $J${"glass-blur": "12px"}$J$::jsonb WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET tokens = tokens || $J${"glass-blur": "20px"}$J$::jsonb WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
