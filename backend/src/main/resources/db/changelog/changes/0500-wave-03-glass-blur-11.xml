<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": glass blur 12px → 11px (DESIGN §10.2).

      One more step of the same tuning as the 0490 seed: the ribbon behind the tile should be read, not
      guessed. The number has nothing else to explain beyond "by the owner's eye on the live board":
      the knob in the DB was set up exactly for this.

      The fallback in var() inside wave-03.css is updated with the same number.
    -->
    <changeSet id="0500-wave-03-glass-blur-11" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET tokens = tokens || $J${"glass-blur": "11px"}$J$::jsonb WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET tokens = tokens || $J${"glass-blur": "12px"}$J$::jsonb WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
