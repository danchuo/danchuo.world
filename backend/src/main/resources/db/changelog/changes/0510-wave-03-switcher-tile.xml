<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the switcher tile grows 4x4 → 8x5 (DESIGN §2.6, §10.2).

      The skin stretched the chips over the whole tile, but on four cells of the 40x28 grid (about 147x115px
      on the owner's screen) the three cards came out as narrow 31px strips. The wave tile is currently
      the only widget on the board: there is room under it, and a wave card should be a card,
      not a strip.

      This state is a WORKING one, like the lone switcher from the 0480 seed itself: when the widgets
      start coming back, the tile returns to its size by editing these two numbers.
      The position is recalculated so the tile stays in the centre of the grid.

      An UPDATE by jsonb path: the rest of the delta (hidden tiles, mobileOrder) is untouched.
    -->
    <changeSet id="0510-wave-03-switcher-tile" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,waveSwitcher}',
        $J${"col": 17, "row": 12, "colSpan": 8, "rowSpan": 5}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,waveSwitcher}',
        $J${"col": 19, "row": 13, "colSpan": 4, "rowSpan": 4}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
