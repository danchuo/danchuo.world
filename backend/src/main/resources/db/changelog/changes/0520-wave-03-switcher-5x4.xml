<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the switcher tile 8x5 → 5x4 (DESIGN §2.6, §10.2).

      The owner looked at eight cells of width on the live board and reduced it: cards filling the tile
      read at five too, and the tile stops being the main blot of the empty screen. The height is
      effectively the same (rowSpan 4 and 5 give the same card height after the insets), the width
      goes from 298 to 185 pixels on a 1536 screen.

      The chip silhouette's step is now computed from the row width (wave-03.css), so changing
      the tile size needs no skin edit: wave 01's staircase adjusts itself.

      The position is recalculated for the centre of the 40x28 grid.
    -->
    <changeSet id="0520-wave-03-switcher-5x4" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,waveSwitcher}',
        $J${"col": 18, "row": 13, "colSpan": 5, "rowSpan": 4}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,waveSwitcher}',
        $J${"col": 17, "row": 12, "colSpan": 8, "rowSpan": 5}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
