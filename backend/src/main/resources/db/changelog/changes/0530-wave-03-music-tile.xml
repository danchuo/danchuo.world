<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03 «PRIME»: на борд возвращается первый виджет — музыка (DESIGN §10.2).

      Порядок возвращения задан ещё сидом 0480: холст правится на пустом экране, виджеты
      приезжают по одному. Музыка идёт первой не по алфавиту — это единственная плитка,
      которая меняется сама собой, без клика и без выбора дня: играющий трек обновляется
      поллингом. За стеклом, которое размывает ленту холста под собой, живой виджет
      показывает материал волны честнее статичного.

      Композиция. Переключатель перестаёт быть центром: он не содержимое, а орган
      управления, и делить с виджетом оптический центр ему нечем. Пара выстраивается в
      столбик по одной оси: музыка сверху, под ней через прослойку — ряд карт волн.
      Столбик поднят на строку выше геометрического центра — оптический центр экрана
      лежит выше середины.

      Ширина переключателя 5 -> 6 колонок, и это не про размер карт, а про ОСЬ. Плитка
      шириной в нечётное число колонок на чётной сетке 40 центроваться не умеет: пятёрка
      садилась на 19.5-ю колонку, музыка (12 колонок) — ровно на 20-ю, и на экране 1536
      два стеклянных прямоугольника расходились центрами на 19px. Заметно: столбик из двух
      плиток читается по общей оси, и промах в полколонки видно раньше, чем сами размеры.
      Шестёрка встаёт на 20-ю колонку точно.

      Музыке дан кадр шире и выше её дефолта (12x7 против 8x5): карточка внутри жмётся
      к содержимому и центрируется сама (см. `MusicTile`), поэтому широкий кадр не растягивает
      стекло — он лишь даёт списку недавних вертикаль, а длинному названию трека ширину,
      на которой бегущая строка не нужна.

      Пер-тайл эталоны Playwright этой волны по-прежнему не касаются (канон — волна 01).
    -->
    <changeSet id="0530-wave-03-music-tile" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(
            jsonb_set(layout, '{tiles,music}', $J${"col": 15, "row": 8, "colSpan": 12, "rowSpan": 7}$J$::jsonb),
            '{tiles,waveSwitcher}',
            $J${"col": 18, "row": 16, "colSpan": 6, "rowSpan": 4}$J$::jsonb
        ),
        '{mobileOrder}',
        $J$["music", "waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(
            jsonb_set(layout, '{tiles,music}', $J${"hidden": true}$J$::jsonb),
            '{tiles,waveSwitcher}',
            $J${"col": 18, "row": 13, "colSpan": 5, "rowSpan": 4}$J$::jsonb
        ),
        '{mobileOrder}',
        $J$["waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
