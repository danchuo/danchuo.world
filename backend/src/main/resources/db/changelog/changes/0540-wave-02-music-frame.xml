<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 02 "Obscura": the music tile narrows by a column on each side (DESIGN §7.5).

      The tile got 13 columns of the 40x28 grid (about 490px on the owner's screen) when it was
      a line of text with a small cover on the side: the width went to a marquee with a long
      title. Now the tile is a FRAME, its cover fills the card, and extra width works
      against it: the frame stretches into a panorama, while the cover is square and gets cropped at the sides.

      11 columns at the same height give a proportion closer to a square: the cover keeps more
      of itself. The column on the left and right goes into the same air the whole grid is made of
      (see the layout.ts header), so the neighbours did not need moving: 16→17 with 13→11 keeps
      the tile's centre in place.
    -->
    <changeSet id="0540-wave-02-music-frame" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 17, "row": 21, "colSpan": 11, "rowSpan": 8}$J$::jsonb
    )
WHERE key = 'wave-02';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 16, "row": 21, "colSpan": 13, "rowSpan": 8}$J$::jsonb
    )
WHERE key = 'wave-02';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
