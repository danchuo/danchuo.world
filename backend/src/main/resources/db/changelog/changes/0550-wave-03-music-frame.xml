<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the Spotify plate narrows by a column on each side (DESIGN §7.5).

      The tile got twelve columns while the card inside hugged its content and the extra
      width went into a reserve for a long title. The plate does not use the reserve: it is stretched over the whole
      cell (`width: 100%` in the skin), so each extra column goes not into text but into an empty
      black field to its right.

      Ten columns at the same height are the same plate, just tighter. The tile's centre stays
      on the wave switcher's axis: 15→16 with 12→10 moves both edges inward symmetrically.
    -->
    <changeSet id="0550-wave-03-music-frame" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 16, "row": 8, "colSpan": 10, "rowSpan": 7}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 15, "row": 8, "colSpan": 12, "rowSpan": 7}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
