<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 02 "Obscura": the music tile narrows by another column on each side (DESIGN §7.5).

      The second step of the same narrowing as the 0540 seed, for the same reason: a frame with a cover wants
      a proportion closer to a square. 9 columns by 8 rows is 338x238 on the owner's screen,
      i.e. almost 1.4:1 against the 2.2:1 it started from.

      The tile's centre again stays in place: 17→18 with 11→9.
    -->
    <changeSet id="0560-wave-02-music-square" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 18, "row": 21, "colSpan": 9, "rowSpan": 8}$J$::jsonb
    )
WHERE key = 'wave-02';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 17, "row": 21, "colSpan": 11, "rowSpan": 8}$J$::jsonb
    )
WHERE key = 'wave-02';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
