<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03 «PRIME»: на борд возвращается второй виджет — последний дроп (DESIGN §10.2),
      в редакции «кадр» (`edition: "frame"`): один случайный снимок во всю карточку, подпись
      в нижней полосе прогрессивного блюра.

      Композиция из столбика становится парой. Столбик «музыка над переключателем» стоял
      на оси 20-й колонки; дроп — плитка того же веса, что музыка, и ставить его сверху или
      снизу значило бы вытянуть столбик на три четверти высоты экрана. Вместо этого дроп
      встаёт СЛЕВА от столбика. Центроваться на сетке обязана ГРУППА: 10 + прослойка + 10 = 21
      колонка на чётной сетке 40 промахивается мимо оси на полколонки — те же 19px, что
      ловили сидом 0530 у одинокого столбика. Поэтому дроп на колонку шире музыки (11):
      группа 11 + 1 + 10 = 22 колонки, колонки 10–31, по девять пустых с каждого края.
      Столбик ради этого съезжает вправо на шесть колонок (16→22, 18→24); внутри пары ось
      «музыка над переключателем» сохранена.

      Строки — это СЛОТ, а не плитка. Карточка кадра берёт пропорцию самого снимка (решение
      владельца): лежачий кадр — лежачая карточка во всю ширину слота, стоячий — стоячая во
      всю высоту, и то и другое центрировано в слоте. Слот поэтому бронируется КВАДРАТОМ с
      запасом, чтобы ни одна ориентация не заехала на соседей: 11 колонок ≈ 413px, 16 строк ≈
      448px на опоре 1536 — квадрат в пределах 8%. Строки 6–21: центр слота — строка 14, та
      же, что у столбика справа (музыка 8–14 + переключатель 16–19), то есть пара сидит на
      одной горизонтальной оси, и оптический центр по-прежнему выше геометрического.

      Мобильный порядок: дроп между музыкой и переключателем — переключатель остаётся
      последним, как на всех волнах (орган управления замыкает стек, а не открывает его).
    -->
    <changeSet id="0590-wave-03-latest-drop" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(
            jsonb_set(
                jsonb_set(layout, '{tiles,latestDrop}', $J${"col": 10, "row": 6, "colSpan": 11, "rowSpan": 16, "edition": "frame"}$J$::jsonb),
                '{tiles,music}',
                $J${"col": 22, "row": 8, "colSpan": 10, "rowSpan": 7}$J$::jsonb
            ),
            '{tiles,waveSwitcher}',
            $J${"col": 24, "row": 16, "colSpan": 6, "rowSpan": 4}$J$::jsonb
        ),
        '{mobileOrder}',
        $J$["music", "latestDrop", "waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(
            jsonb_set(
                jsonb_set(layout, '{tiles,latestDrop}', $J${"hidden": true}$J$::jsonb),
                '{tiles,music}',
                $J${"col": 16, "row": 8, "colSpan": 10, "rowSpan": 7}$J$::jsonb
            ),
            '{tiles,waveSwitcher}',
            $J${"col": 18, "row": 16, "colSpan": 6, "rowSpan": 4}$J$::jsonb
        ),
        '{mobileOrder}',
        $J$["music", "waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
