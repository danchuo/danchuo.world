<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the Spotify plate loses one more row of height (7 → 6, rows 8–13).
      The owner's request on the live board: the plate is flattened on purpose (its mark, seed 0570),
      and after the drop returned next to it, it again looked a bit tall.

      The column's top and the switcher's bottom do not move (8 … 19), so the "drop + column" pair
      stays on the same horizontal axis; the freed row 14 goes into the spacer
      between music and the switcher.
    -->
    <changeSet id="0610-wave-03-music-shorter" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 22, "row": 8, "colSpan": 10, "rowSpan": 6}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        layout,
        '{tiles,music}',
        $J${"col": 22, "row": 8, "colSpan": 10, "rowSpan": 7}$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
