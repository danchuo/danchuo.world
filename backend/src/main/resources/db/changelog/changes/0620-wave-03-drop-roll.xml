<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the drop gallery opens as a FILM ROLL (`gallery: "roll"`, DESIGN §7.5).
      A 37-frame drop reads as a reel (a large frame, a thumbnail strip, a tick per
      frame) rather than a grid: the owner's choice out of five prototypes (a contact sheet with a loupe ·
      an endless table · film · a stack in depth · a sorting table).

      The field lives at the layout ROOT, not in the tile's span: both drop tiles open the gallery
      (the latest drop and the ribbon of past ones), and a wave has one edition: otherwise the same drop
      would open differently depending on the entry point. Waves 01 and 02 have no field and
      stay on the mosaic (the code default).
    -->
    <changeSet id="0620-wave-03-drop-roll" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(layout, '{gallery}', $J$"roll"$J$::jsonb)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = layout - 'gallery'
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
