<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 "PRIME": the projects return to the board, in the `dossier` edition (DESIGN §7.8, §10.2).

      A project does not explain itself with a picture the way a film frame does: the planet sprite
      is pretty, but what stands behind it does not follow from it. So the dossier row speaks three times:
      the title, under it the REPOSITORY PATH in green (the code channel token), the quarter on the right.
      The tile's caption is the shell prompt `~/projects ❯ ls -l`: it lives in
      the content, not in the meta label this wave hides on every tile.

      Geometry. The column stands UNDER the latest drop's frame and exactly its width (col. 5,
      11 tracks): the two tiles share one column and keep the board's left edge common. The height of 6
      tracks (≈175px at 1536) fits three dossier rows in the window without scrolling (measured on the live
      board), i.e. a year's reserve at the current pace (a project per quarter); the fourth
      scrolls, like the drop ribbon. Row 23: after an empty spacer track under the frame, which ends at 22.

      `orientation` is not set on purpose: the dossier's layout is vertical by nature (two lines of text
      per row), and the tile drops the orientation itself. Waves 01 and 02 have no `edition` field and
      stay on the old folded list (the code default).
    -->
    <changeSet id="0640-wave-03-projects" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(layout, '{tiles,projects}', $J${"col": 5, "row": 23, "colSpan": 11, "rowSpan": 6, "edition": "dossier"}$J$::jsonb),
        '{mobileOrder}',
        $J$["music", "latestDrop", "photoDrops", "projects", "waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
        jsonb_set(layout, '{tiles,projects}', $J${"hidden": true}$J$::jsonb),
        '{mobileOrder}',
        $J$["music", "latestDrop", "photoDrops", "waveSwitcher"]$J$::jsonb
    )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
