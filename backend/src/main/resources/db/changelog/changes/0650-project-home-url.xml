<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      A project gets a SECOND link (PRD §5.7), because it has two different addresses:
      `url` is the path the block SHOWS as a line under the title (a repository or a site),
      `home_url` is where the item itself leads: the title and the picture.

      Until now there was one address, and it played both roles. They diverge where the code lives
      somewhere other than the project itself: proxemics has its repository on GitHub, while people use it via
      a Telegram bot. Showing a link to the bot in the line is not possible: it would stop being a repository
      path, i.e. the "this is code" signal; leading the title to the repository is not possible either:
      the visitor wants to open the project itself, not its sources.

      `home_url` = null ⇒ there is no separate home, and the item leads where the path does. That is the case for
      the site: the shown path is its home.
    -->
    <changeSet id="0650-project-home-url" author="danchuo">
        <addColumn tableName="project">
            <column name="home_url" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

    <!--
      The site project shows ITS OWN ADDRESS (the owner's decision): the field used to hold a link to
      the owner's profile, and the line answered "whose code is this" rather than "what is this thing". It has no
      separate home: the shown path leads there.
    -->
    <changeSet id="0650-danchuo-world-site-link" author="danchuo">
        <update tableName="project">
            <column name="url" value="https://danchuo.world"/>
            <where>title = 'danchuo.world'</where>
        </update>
    </changeSet>

    <!-- proxemics: the path stays the repository, the home is a Telegram bot. -->
    <changeSet id="0650-proxemics-home" author="danchuo">
        <update tableName="project">
            <column name="home_url" value="https://t.me/proxemics_bot"/>
            <where>title = 'proxemics'</where>
        </update>
    </changeSet>
</databaseChangeLog>
