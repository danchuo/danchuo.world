<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03: плитка проектов переезжает с редакции `dossier` на `console` (DESIGN §7.8).

      Редакция та же по составу строки (иконка · название · зелёный путь · квартал), но
      теперь это вывод `tree`: строки висят на ветках под приглашением оболочки. Переименование
      не косметическое — «досье» описывало папку с бумагами, а на борде стоит окно терминала,
      и скин волны с этой ветки одевает плитку панелью консоли вместо стекла.

      Дельту раскладки переписываем ЦЕЛИКОМ, а не патчим ключ: `jsonb_set` по глубокому пути
      молча ничего не сделает, если промежуточного ключа не окажется, — а тут вся ветка
      `tiles.projects` наша и известна.
    -->
    <changeSet id="0660-wave-03-projects-console" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 11, "rowSpan": 6, "edition": "console"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 11, "rowSpan": 6, "edition": "dossier"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
