<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the projects tile moves from the `dossier` edition to `console` (DESIGN §7.8).

      The row's content is the same (icon · title · green path · quarter), but
      it is now the output of `tree`: rows hang on branches under the shell prompt. The rename
      is not cosmetic: "dossier" described a folder of papers, while the board has a terminal window,
      and from this branch the wave's skin dresses the tile in a console panel instead of glass.

      The layout delta is rewritten WHOLE rather than patching a key: `jsonb_set` on a deep path
      silently does nothing if an intermediate key is missing, and here the whole branch
      `tiles.projects` is ours and known.
    -->
    <changeSet id="0660-wave-03-projects-console" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 11, "rowSpan": 6, "edition": "console"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 11, "rowSpan": 6, "edition": "dossier"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
