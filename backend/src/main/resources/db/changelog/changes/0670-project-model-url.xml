<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      A project gets a SECOND planet, a 3D one (DESIGN §12.5).

      A separate column rather than replacing `icon_url`: the flat sprite stays with the project forever,
      because not every wave is entitled to wear volume. Wave 01 "Studio / Peach" shows
      warm pixel art, and a cyan wireframe is foreign there; which planet to wear is decided by the wave
      in its layout (`tiles.projects.planet`), and the project row simply keeps both.

      `model_url` empty ⇒ the project has no 3D version, and a wave asking for volume shows the sprite.
    -->
    <changeSet id="0670-project-model-url" author="danchuo">
        <addColumn tableName="project">
            <column name="model_url" type="varchar(512)"/>
        </addColumn>
    </changeSet>

    <changeSet id="0670-project-model-url-danchuo-world" author="danchuo">
        <update tableName="project">
            <column name="model_url" value="/assets/3d/wireframe-globe.glb"/>
            <where>title = 'danchuo.world'</where>
        </update>
        <rollback>
            <update tableName="project">
                <column name="model_url" value="null"/>
                <where>title = 'danchuo.world'</where>
            </update>
        </rollback>
    </changeSet>

    <changeSet id="0670-project-model-url-proxemics" author="danchuo">
        <update tableName="project">
            <column name="model_url" value="/assets/3d/spiral-vortex.glb"/>
            <where>title = 'proxemics'</where>
        </update>
        <rollback>
            <update tableName="project">
                <column name="model_url" value="null"/>
                <where>title = 'proxemics'</where>
            </update>
        </rollback>
    </changeSet>
</databaseChangeLog>
