<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the projects' time moved from the row into the section header (the year), the row's right
      column disappeared, and the tile shrinks by three tracks on the right. The right edge from column 14
      to 11; the left edge and the height do not move.

      The layout delta is rewritten WHOLE, as in 0660/0680/0690: `jsonb_set` on a deep
      path silently does nothing if an intermediate key is missing, and the whole branch is ours.
    -->
    <changeSet id="0700-wave-03-projects-narrower" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 7, "rowSpan": 6, "edition": "console", "planet": "model"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,projects}',
  $J${"col": 5, "row": 23, "colSpan": 10, "rowSpan": 6, "edition": "console", "planet": "model"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>

    <!--
      danchuo.world is "to date" again: an open range end.

      This reverses decision 0200-project-danchuo-q3 ("no to date"), and here is why it
      no longer holds. Back then an open end meant exactly one thing: the word "now" in the row's right
      column, and that word was what the owner disliked. The column is gone: `end_year`
      now decides two other things: which year group the project falls into (an open end =
      the current year, i.e. the top group) and whether the title glows at full brightness. The site
      you are reading now is alive, and both of these must tell the truth.
    -->
    <changeSet id="0700-project-danchuo-open-end" author="danchuo">
        <update tableName="project">
            <!-- `valueComputed`, not an empty `value`: NULL is spelled out explicitly rather than
               inferred from a missing attribute. -->
            <column name="end_year" valueComputed="NULL"/>
            <column name="end_quarter" valueComputed="NULL"/>
            <where>title = 'danchuo.world'</where>
        </update>
        <rollback>
            <update tableName="project">
                <column name="end_year" valueNumeric="2026"/>
                <column name="end_quarter" valueNumeric="3"/>
                <where>title = 'danchuo.world'</where>
            </update>
        </rollback>
    </changeSet>
</databaseChangeLog>
