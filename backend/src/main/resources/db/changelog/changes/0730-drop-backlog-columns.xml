<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The day's placeholder columns (PRD §9). They were created "for the future" and stood empty for a year:
      Apple's screen time is not available programmatically, day photos were never taken, and reading progress
      has long been counted by the reading slice, per session and in percent, i.e. more precisely and elsewhere.
      Nothing is migrated: there was nothing to write into them. If they are ever needed, they will be created together
      with the channel that writes into them.
    -->
    <changeSet id="0730-day-record-drop-backlog-columns" author="danchuo">
        <dropColumn tableName="day_record" columnName="screen_time_minutes"/>
        <dropColumn tableName="day_record" columnName="reading_progress_percent"/>
        <dropColumn tableName="day_record" columnName="day_photo_url"/>
    </changeSet>
</databaseChangeLog>
