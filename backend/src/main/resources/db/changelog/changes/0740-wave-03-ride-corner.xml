<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: Velobike moves to the board's BOTTOM RIGHT corner and becomes noticeably narrower and lower.
      The tile does not stick to the canvas's very edges: a band of air remains on the right and at the bottom, as
      at the board's other corners. What stands where: DESIGN §10.2.

      The mobile stack is untouched: the order there is about reading sequence, not corners.

      The layout delta is rewritten WHOLE (as in 0660/0680/0700/0710): `jsonb_set` on
      a deep path silently does nothing if an intermediate key is missing.
    -->
    <changeSet id="0740-wave-03-ride-corner" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,ride}',
  $J${"col": 29, "row": 21, "colSpan": 7, "rowSpan": 7, "edition": "map"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,ride}',
  $J${"col": 17, "row": 14, "colSpan": 9, "rowSpan": 9, "edition": "map"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
