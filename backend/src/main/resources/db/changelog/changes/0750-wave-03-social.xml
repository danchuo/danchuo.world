<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the social widget returns to the board: another of those 0480 hid
      until each is dressed for glass (DESIGN §10.2).

      It stands as a STRIP in the bottom middle of the canvas: columns 16-24, rows 24-26. The place is chosen by
      the neighbours: the projects console on the left (5-11), the Velobike map on the right (29-35), the drop
      ribbon above; the strip lies between them without rubbing against any. Three rows high, because
      there is exactly one row of marks' worth of content: the tile has no slab and no captions, and extra
      height would be emptiness stretching the row.

      The mobile stack gets the widget last: links are the board's signature, not its beginning.

      The layout delta is edited PRECISELY (`jsonb_set` on the existing `tiles.social` key):
      the key has been in the delta since 0480, no intermediate nodes need to be created.
    -->
    <changeSet id="0750-wave-03-social" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,social}',
  $J${"col": 16, "row": 24, "colSpan": 9, "rowSpan": 3}$J$::jsonb
) || jsonb_build_object(
  'mobileOrder',
  (layout -> 'mobileOrder') || '["social"]'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(layout, '{tiles,social}', $J${"hidden": true}$J$::jsonb)
  || jsonb_build_object(
       'mobileOrder',
       (layout -> 'mobileOrder') - 'social'
     )
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
