<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The latest Instagram post (PRD §5.17). Two singleton rows: the owner's token and the post itself:
      there is one account, and exactly one post is shown on the board.

      The token is stored ENCRYPTED (AES-GCM, PRD §8), like the Spotify refresh token, and the issue time is stored
      in a separate column: a renewal issues a new sixty-day term, and it can only be counted
      from the issue.

      The post and avatar pictures are not in the DB at all, only on disk: Instagram links
      are signed and live for hours, so the bytes are taken for ourselves (InstagramImageStorage).
    -->
    <changeSet id="0770-instagram-token" author="danchuo">
        <createTable tableName="instagram_token">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="encrypted_access_token" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0770-instagram-post" author="danchuo">
        <createTable tableName="instagram_post">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="media_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="permalink" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="caption" type="TEXT"/>
            <column name="media_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <!-- The counters are nullable: the owner may hide them on a post, and then the API does not send them. -->
            <column name="like_count" type="INTEGER"/>
            <column name="comments_count" type="INTEGER"/>
            <column name="posted_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="fetched_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
