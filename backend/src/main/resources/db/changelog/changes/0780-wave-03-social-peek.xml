<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 turns on the social edition in which the latest post pops up under the Instagram mark
      (PRD §5.17). The decision arrives through the wave's LAYOUT, not through a check of the wave key in code:
      otherwise every new wave would require a component edit.

      The tile's place is edited by the same query: the edition is a field of the same span, and there is no reason
      to split it into two updates. What stands where: DESIGN §10.2.
    -->
    <changeSet id="0780-wave-03-social-peek" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,social}',
  $J${"col": 34, "row": 2, "colSpan": 7, "rowSpan": 2, "edition": "peek"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(layout, '{tiles,social}', $J${"col": 34, "row": 2, "colSpan": 7, "rowSpan": 2}$J$::jsonb)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
