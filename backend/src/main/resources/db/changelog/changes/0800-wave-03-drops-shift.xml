<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the drop ribbon moves one row up and two columns right.

      Only the coordinates move, the size is the same (8 by 9). Hence the precise jsonb_set on
      the `col` and `row` keys rather than replacing the tile's whole record: it has the `carousel` edition,
      and the whole record would have to be rewritten together with it, risking losing it on
      the next edit of a neighbouring number.
    -->
    <changeSet id="0800-wave-03-drops-shift" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  jsonb_set(layout, '{tiles,photoDrops,col}', '19'::jsonb),
  '{tiles,photoDrops,row}', '2'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  jsonb_set(layout, '{tiles,photoDrops,col}', '17'::jsonb),
  '{tiles,photoDrops,row}', '3'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
