<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the calendar returns to the board in the "field" edition (DESIGN 5.2).

      The tile has been hidden since the wave's seed: the widgets return one at a time as each
      is dressed for glass. Here the tile's record is rewritten WHOLE rather than with precise jsonb_set on
      keys: the calendar had only `hidden` in the delta, with no coordinates or edition at
      all, so there is nothing to lose in the replacement.

      The slot is columns 19..27, rows 13..22: the board's empty middle under the drop ribbon
      (which ends at row 10) and left of the wave switcher (which starts at column 29). The size
      is the default, 9 by 10: the calendar's cell proportion is already tuned for it.

      The mobile order is listed anew: a tile not named in it goes to the tail of the
      stack in the default order, while the calendar is the main navigation here and must not
      stand last.
    -->
    <changeSet id="0810-wave-03-calendar-field" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  jsonb_set(
    layout,
    '{tiles,calendar}',
    '{"col":19,"row":13,"colSpan":9,"rowSpan":10,"hidden":false,"edition":"field"}'::jsonb
  ),
  '{mobileOrder}',
  '["music","latestDrop","calendar","photoDrops","ride","projects","waveSwitcher","social"]'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  jsonb_set(layout, '{tiles,calendar}', '{"hidden":true}'::jsonb),
  '{mobileOrder}',
  '["music","latestDrop","photoDrops","ride","projects","waveSwitcher","social"]'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
