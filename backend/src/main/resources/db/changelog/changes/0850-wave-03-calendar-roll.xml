<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03 включает ход окна календаря (DESIGN 5.2, 10.2).

      Наплыв редакция «поле» умела с самого начала, но длительность у него — токен волны, и
      по умолчанию она нулевая: редакция сама ничего не анимирует. Без этой записи окно
      меняло содержимое мгновенно — жест был, а движения не было.

      Смещение соразмерно ряду сетки (на опоре владельца ряд около 49px): недели меняются
      местами, и мелкий толчок этого не показывал. Длительность не длиннее минимального
      зазора между шагами жеста — иначе ход отставал бы от колеса.
    -->
    <changeSet id="0850-wave-03-calendar-roll" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET tokens = tokens || '{"cal-roll-ms":"200ms","cal-roll-shift":"30px"}'::jsonb
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET tokens = tokens - 'cal-roll-ms' - 'cal-roll-shift'
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
