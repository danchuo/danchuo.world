<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03 turns on the calendar window's movement (DESIGN 5.2, 10.2).

      The "field" edition could slide from the start, but its duration is a wave token, and
      by default it is zero: the edition animates nothing by itself. Without this record the window
      changed its content instantly: there was a gesture but no movement.

      The offset is proportional to a grid row (at the owner's reference a row is about 49px): the weeks swap
      places, and a small nudge did not show that. The duration is no longer than the minimum
      gap between the gesture's steps: otherwise the movement would lag behind the wheel.
    -->
    <changeSet id="0850-wave-03-calendar-roll" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET tokens = tokens || '{"cal-roll-ms":"200ms","cal-roll-shift":"30px"}'::jsonb
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET tokens = tokens - 'cal-roll-ms' - 'cal-roll-shift'
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
