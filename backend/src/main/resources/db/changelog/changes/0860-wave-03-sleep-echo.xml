<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: sleep returns to the board in the "echo sounder" edition (DESIGN §7.7, §10.2).

      Until now the widget was hidden on this wave: the old layout (share bars on the left, the night's
      lanes on the right) is wave 01's language, and on glass it read as a guest. The "echo sounder" draws the night
      as a depth sounding filling the tile, without margins and without the word "sleep": in the same manner as the frame
      in the drop tile and the ride data on the map.

      Place: columns 19..27, rows 12..19: the free block between the drop carousel (which ends
      at row 10) and the calendar (which starts at 21). The width is TAKEN FROM THE CALENDAR, not
      picked: both tiles stand in one column, and edges drifting apart would read as a layout
      defect. Rows 11 and 20 stay air: a spacer to the neighbours above and below.

      The proportion comes out close to 8:5 (335×209 at the owner's reference width):
      exactly the one the sounding is laid out for: the night's descent reads left to right, and the tile
      is meant to be landscape.
    -->
    <changeSet id="0860-wave-03-sleep-echo" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  $J${"col": 19, "row": 12, "colSpan": 9, "rowSpan": 8, "hidden": false, "edition": "echo"}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  $J${"hidden": true}$J$::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
