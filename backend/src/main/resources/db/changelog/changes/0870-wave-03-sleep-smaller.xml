<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03: «эхолот» ужимается на трек справа и на трек снизу (DESIGN §10.2).

      Колонки 19..26, строки 12..18. Правый край при этом СХОДИТ с колонки календаря, на
      которую был выровнен: колонка справа от промера теперь ступенчатая — сон кончается
      на треке раньше календаря под ним. Размен сознательный — промер в прежнем габарите
      забирал у борда больше веса, чем стоит один показатель дня.

      Пропорция остаётся лежачей (около 8:5), то есть той, на которой промер и размечен:
      спуск ночи читается слева направо.
    -->
    <changeSet id="0870-wave-03-sleep-smaller" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"colSpan": 8, "rowSpan": 7}'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"colSpan": 9, "rowSpan": 8}'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
