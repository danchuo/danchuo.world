<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the "echo sounder" shrinks by a track on the right and a track at the bottom (DESIGN §10.2).

      Columns 19..26, rows 12..18. The right edge thereby LEAVES the calendar's column it
      was aligned with: the column to the right of the sounding is now stepped: sleep ends
      one track before the calendar under it. A deliberate trade: the sounding at its old size
      took more of the board's weight than a single daily figure deserves.

      The proportion stays landscape (about 8:5), i.e. the one the sounding is laid out for:
      the night's descent reads left to right.
    -->
    <changeSet id="0870-wave-03-sleep-smaller" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"colSpan": 8, "rowSpan": 7}'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"colSpan": 9, "rowSpan": 8}'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
