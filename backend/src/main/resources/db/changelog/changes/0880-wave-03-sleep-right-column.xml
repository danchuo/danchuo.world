<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the "echo sounder" moves to the right column: under Spotify and above the wave switcher
      (DESIGN §10.2). Columns 31..40 (the music tile's width), rows 11..16.

      The rows are chosen so the air stays a TRACK rather than a grid gap: music ends
      at row 9, the switcher starts at 18, and the empty tracks 10 and 17 hold the bands above
      and below. Row 17 is deliberately not taken for the sounding: otherwise sleep would hit the switcher
      across a single four-pixel gap, while all neighbours on the board have a whole track
      between tiles.

      The proportion becomes more landscape (about 2.1 against the old 1.45): the sounding is laid out
      for a left-to-right descent, and extra width suits it, while the caption band's height
      is given back by its own edition.
    -->
    <changeSet id="0880-wave-03-sleep-right-column" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"col": 31, "row": 11, "colSpan": 10, "rowSpan": 6}'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,sleep}',
  (layout->'tiles'->'sleep') || '{"col": 19, "row": 12, "colSpan": 8, "rowSpan": 7}'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
