<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: the wave switcher returns to the right column: between the sleep sounding and
      Velobike (DESIGN §10.2).

      Columns 35..40, rows 19..20. The sounding ends at 17, Velobike starts at 22,
      so rows 18 and 21 stay empty tracks: the air above and below is the same as for
      the other neighbours on the board. The right edge holds the board's wall, like the sounding and Velobike
      above and below it. The tile's size does not change: the same 6 columns by 2 rows.

      The left column's header (rows 2..5 above the latest drop) stays empty.
    -->
    <changeSet id="0920-wave-03-switcher-right-column" author="danchuo">
        <sql><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,waveSwitcher}',
  (layout->'tiles'->'waveSwitcher') || '{"col": 35, "row": 19, "colSpan": 6, "rowSpan": 2}'::jsonb
)
WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme
SET layout = jsonb_set(
  layout,
  '{tiles,waveSwitcher}',
  (layout->'tiles'->'waveSwitcher') || '{"col": 5, "row": 2, "colSpan": 6, "rowSpan": 2}'::jsonb
)
WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
