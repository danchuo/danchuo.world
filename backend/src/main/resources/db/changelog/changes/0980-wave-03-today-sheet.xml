<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: "Today" is dressed in the "contact sheet" edition (DESIGN §4.3).

      The default layout on this wave read as a guest from wave 01: the header with the 2/5 to 3/5 split and
      the trail map are its language, not glass's. The edition changes the question: the unit shown is the SESSION, not
      the item, and each session arrives as its own full-frame cover.

      The tile loses its slab entirely (the wave's skin): the material here is the frames themselves.
    -->
    <changeSet id="0980-wave-03-today-sheet" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  layout->'tiles'->'today' || '{"edition": "sheet"}'::jsonb) WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  (layout->'tiles'->'today') - 'edition') WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
