<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Wave 03: "Today" shrinks by one column on the left (the owner's hand-tune): 1..19 → 2..19.

      The tile's left edge moves off the board's edge and stops lining up with the drop above it;
      the height and the right edge are untouched. No collisions: column 1 on the left empties, on the right the tile
      still stops at the empty track 20 before the middle column.
    -->
    <changeSet id="0990-wave-03-today-narrower" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  layout->'tiles'->'today' || '{"col": 2, "colSpan": 18}'::jsonb) WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  layout->'tiles'->'today' || '{"col": 1, "colSpan": 19}'::jsonb) WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
