<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Волна 03: «Сегодня» ужимается на одну колонку слева (хэнд-тюн владельца): 1..19 → 2..19.

      Левый край плитки отходит от края борда и перестаёт стоять в одну линию с дропом над ней;
      высота и правый край не тронуты. Столкновений нет: слева колонка 1 пустеет, справа плитка
      по-прежнему упирается в пустой трек 20 перед средней колонной.
    -->
    <changeSet id="0990-wave-03-today-narrower" author="danchuo">
        <sql><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  layout->'tiles'->'today' || '{"col": 2, "colSpan": 18}'::jsonb) WHERE key = 'wave-03';
        ]]></sql>
        <rollback><![CDATA[
UPDATE theme SET layout = jsonb_set(layout, '{tiles,today}',
  layout->'tiles'->'today' || '{"col": 1, "colSpan": 19}'::jsonb) WHERE key = 'wave-03';
        ]]></rollback>
    </changeSet>
</databaseChangeLog>
