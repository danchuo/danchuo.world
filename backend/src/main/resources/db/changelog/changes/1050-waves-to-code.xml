<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The waves move from the DB into the frontend's code (PRD §5.9, DESIGN §10.1). The palette and layout live
      in frontend/src/lib/waves/ next to the wave's skin, the theme slice is removed entirely.

      Why: the promise "a wave is a DB row, changed in prod without a deploy" was never kept:
      no write knob ever appeared, and every one-track tile nudge came as a migration plus a backend
      rollout. 49 of the 105 files in this folder are exactly such 2.5 KB JSON edits. In code it is a
      TypeScript edit under typecheck and a layout test (tile non-overlap is checked by a machine, not
      by a comment in a migration).

      The rollback recreates an empty table: the waves' content now lives in the frontend repository, not here.
    -->
    <changeSet id="1050-drop-theme" author="danchuo">
        <dropTable tableName="theme"/>
        <rollback>
            <createTable tableName="theme">
                <column name="id" type="BIGINT" autoIncrement="true">
                    <constraints primaryKey="true" nullable="false"/>
                </column>
                <column name="key" type="VARCHAR(64)">
                    <constraints nullable="false" unique="true"/>
                </column>
                <column name="name" type="VARCHAR(128)">
                    <constraints nullable="false"/>
                </column>
                <column name="tokens" type="jsonb">
                    <constraints nullable="false"/>
                </column>
                <column name="layout" type="jsonb"/>
                <column name="active" type="BOOLEAN" defaultValueBoolean="false">
                    <constraints nullable="false"/>
                </column>
                <column name="released_at" type="TIMESTAMP WITH TIME ZONE">
                    <constraints nullable="false"/>
                </column>
            </createTable>
        </rollback>
    </changeSet>
</databaseChangeLog>
