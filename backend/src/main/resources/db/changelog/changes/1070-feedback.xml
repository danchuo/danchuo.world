<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The feedback slice (PRD §5.19, §11): a visitor's note to the author. The three answers are optional
      individually, but at least one must be non-empty: a rule of the entry point (FeedbackPolicy), not of the schema:
      in the database all three are nullable.

      Privacy as in analytics: the raw IP is not stored, only the daily visitor_day_hash. Unlike
      analytics, the UA is stored here as a string: the owner asked to see the browser and OS, and
      a note is voluntary and often signed.

      The column widths are the same values as the ceilings in FeedbackLimits: Postgres does not truncate a long value,
      it fails the insert. One index, for the only read: the admin feed by date.
    -->
    <changeSet id="1070-feedback-note-table" author="danchuo">
        <createTable tableName="feedback_note">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="submitted_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="liked_most" type="VARCHAR(2000)"/>
            <column name="would_change" type="VARCHAR(2000)"/>
            <column name="missing_block" type="VARCHAR(2000)"/>
            <column name="signature" type="VARCHAR(120)"/>

            <column name="path" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="wave_key" type="VARCHAR(64)"/>
            <column name="selected_day" type="DATE"/>

            <column name="device_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="viewport_w" type="INT"/>
            <column name="viewport_h" type="INT"/>
            <column name="screen_w" type="INT"/>
            <column name="screen_h" type="INT"/>
            <column name="language" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(512)"/>

            <column name="visitor_day_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="is_bot" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="feedback_note" indexName="idx_feedback_submitted_at">
            <column name="submitted_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
