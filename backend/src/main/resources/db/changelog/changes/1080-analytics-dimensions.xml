<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Analytics breakdowns (PRD §5.11): without UTM, driven traffic merges into one heap of "direct
      visits", and without the viewport there is nothing to answer DESIGN's question "is the board visible without scrolling".
      The visit's wave is a breakdown nobody else has: the same audience can be compared
      across the board's editions.

      The column widths equal the ceilings in AnalyticsLimits: Postgres does not truncate a long value,
      it fails the insert, and anyone can write here.

      referrer_host is derived on write next to the raw referrer: grouping sources by
      the full URL gives a row per link instead of a row per source.
    -->
    <changeSet id="1080-analytics-event-dimensions" author="danchuo">
        <addColumn tableName="analytics_event">
            <column name="referrer_host" type="VARCHAR(255)"/>
            <column name="utm_source" type="VARCHAR(128)"/>
            <column name="utm_medium" type="VARCHAR(128)"/>
            <column name="utm_campaign" type="VARCHAR(128)"/>
            <column name="wave_key" type="VARCHAR(64)"/>
            <column name="viewport_w" type="INT"/>
            <column name="viewport_h" type="INT"/>
            <column name="scroll_pct" type="INT"/>
        </addColumn>
    </changeSet>

    <!--
      One visit is one row. A time top-up that did not find the load row used to
      insert a second one, and visits counted one person twice. The schema closes this itself:
      uniqueness by visit_id.

      Before the index we clean up what the race already accumulated: the time moves to the surviving row
      (the maximum, not the last value), the duplicates go.
    -->
    <changeSet id="1080-analytics-visit-id-unique" author="danchuo">
        <sql>
            UPDATE analytics_event a
            SET dwell_ms = s.max_dwell
            FROM (
                SELECT visit_id, MAX(dwell_ms) AS max_dwell
                FROM analytics_event
                WHERE visit_id IS NOT NULL
                GROUP BY visit_id
                HAVING COUNT(*) &gt; 1
            ) s
            WHERE a.visit_id = s.visit_id
              AND a.id = (SELECT MIN(b.id) FROM analytics_event b WHERE b.visit_id = a.visit_id);

            DELETE FROM analytics_event a
            WHERE a.visit_id IS NOT NULL
              AND a.id &gt; (SELECT MIN(b.id) FROM analytics_event b WHERE b.visit_id = a.visit_id);
        </sql>
        <dropIndex tableName="analytics_event" indexName="idx_analytics_visit_id"/>
        <sql>
            CREATE UNIQUE INDEX idx_analytics_visit_id
            ON analytics_event (visit_id)
            WHERE visit_id IS NOT NULL;
        </sql>
    </changeSet>

    <!--
      Engagement asks "did the visit have at least one click" with a subquery by visit_id:
      without an index that is a seq scan over the whole clicks table for every day of the period.
    -->
    <changeSet id="1080-interaction-visit-id-index" author="danchuo">
        <createIndex tableName="interaction_event" indexName="idx_interaction_visit_id">
            <column name="visit_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
