<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The danchuo.world migration pipeline (M0 — an empty seam).

      Каждый feature-слайс кладёт свои чейнджлоги в db/changelog/changes/
      and they are picked up by includeAll below (by file name, lexicographically).
      The schema is Liquibase's responsibility, not hbm2ddl's
      (quarkus.hibernate-orm.database.generation=none).
    -->
    <includeAll path="changes/" relativeToChangelogFile="true" errorIfMissingOrEmpty="false"/>
</databaseChangeLog>
