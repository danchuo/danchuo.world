# Куда Next-сервер проксирует /api/* (same-origin прокси, см. next.config.ts).
# ВАЖНО: значение запекается в rewrites на этапе сборки (next build), не в рантайме.
# Локально с бэком на :8080 можно не задавать — это дефолт.
API_PROXY_TARGET=http://localhost:8080

# Базовый URL сайта для абсолютных ссылок в OG-картинке, canonical и sitemap (M5).
# Дефолт — прод-домен; локально/в превью можно переопределить.
SITE_URL=https://danchuo.world
