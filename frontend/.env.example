# Where the Next server proxies /api/* (same-origin proxy, see next.config.ts).
# IMPORTANT: the value is baked into rewrites at build time (next build), not at runtime.
# Locally with the backend on :8080 it can be left unset — that is the default.
API_PROXY_TARGET=http://localhost:8080

# The site's base URL for absolute links in the OG image, canonical and sitemap (M5).
# Defaults to the prod domain; can be overridden locally/in previews.
SITE_URL=https://danchuo.world
