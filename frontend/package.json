{
  "name": "danchuo-world-frontend",
  "version": "1.58.3",
  "private": true,
  "description": "danchuo.world — public frontend + admin (B1: photo drops; B2: click heatmap in /admin; B4: Velobike rides widget)",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/patch-next-font-google.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/patch-next-font-google.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:comments": "node ../scripts/check-comment-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:docker": "bash e2e/docker-baseline.sh run",
    "e2e:docker:update": "bash e2e/docker-baseline.sh update"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.182.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
